# Postgres
POSTGRES_USER=bomtool
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bomtool
DATABASE_URL=postgres://bomtool:changeme@postgres:5432/bomtool

# API
JWT_SECRET=changeme_generate_a_real_secret
API_PORT=4000
API_PUBLIC_URL=https://your-api.onrender.com   # used as the GitHub Actions callback base URL

# GitHub Actions scraping (replaces a live scraper service)
GITHUB_REPO=yourname/bom-tool                  # owner/repo, used to trigger repository_dispatch
GITHUB_DISPATCH_TOKEN=ghp_xxx                  # PAT with "repo" scope (Actions: read/write)
INTERNAL_SCRAPE_SECRET=changeme_shared_secret  # must match the same-named GitHub Actions secret

# Frontend
VITE_API_URL=http://localhost:4000

# Site
SITE_NAME=BOM Tool
SITE_URL=https://example.com
