# Local development / deployment configuration
DATABASE_URL=postgresql://user:password@host/db
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_SCRAPE_SECRET=replace-with-a-long-random-secret
# Encrypts user-supplied secrets at rest (currently: each user's own Apify
# token, see /api/auth/apify-key). Must be 32 raw bytes, base64-encoded --
# generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=replace-with-openssl-rand--base64-32-output
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
API_PORT=4000

# GitHub Actions scraping
GITHUB_REPO=owner/repository
GITHUB_DISPATCH_TOKEN=replace-with-github-token

# Optional GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional public API footer
SITE_NAME=BOM Tool
SITE_URL=http://localhost:5173

# Apify (GitHub Actions scraper config -- Actor IDs only, no token here).
# There is no shared/site-wide APIFY_TOKEN. Each user brings their own
# Apify token via Settings -> Apify API key (stored encrypted, see
# SECRET_ENCRYPTION_KEY above); it's passed through per-request as
# client_payload.apify_token on the GitHub Actions dispatch. A user with
# no token saved still works -- Apify-tier scrapes just fall back to the
# plain HTTP fetch path.
APIFY_AMAZON_ACTOR_ID=junglee/amazon-crawler
APIFY_MOUSER_ACTOR_ID=crawloop/mouser-product-scraper
APIFY_PUPPETEER_ACTOR_ID=
